<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Arpita Roy</title>
  <link rel="icon" type="image/png" href="A.png">
  <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@300;400;500;600;700&family=Space+Grotesk:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
  <style>
    :root {
      --bg: #060a0f;
      --bg2: #0d1520;
      --surface: #111c2d;
      --border: #1e3352;
      --accent: #00d4ff;
      --accent2: #7c3aed;
      --accent3: #00ff88;
      --text: #e2eaf5;
      --muted: #6b8aad;
      --font-mono: 'Fira Code', monospace;
      --font-sans: 'Space Grotesk', sans-serif;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      background: var(--bg);
      color: var(--text);
      font-family: var(--font-sans);
      overflow-x: hidden;
      cursor: none;
    }

    /* ── Custom cursor ── */
    .cursor {
      width: 12px; height: 12px;
      background: var(--accent);
      border-radius: 50%;
      position: fixed; top: 0; left: 0;
      pointer-events: none; z-index: 9999;
      transition: transform .15s ease;
      mix-blend-mode: screen;
    }
    .cursor-ring {
      width: 36px; height: 36px;
      border: 1.5px solid var(--accent);
      border-radius: 50%;
      position: fixed; top: 0; left: 0;
      pointer-events: none; z-index: 9998;
      transition: transform .3s ease, opacity .3s;
      opacity: .6;
    }

    #bg-canvas {
      position: fixed; inset: 0;
      z-index: 0;
      opacity: .45;
    }

    .page {
      position: relative; z-index: 1;
      min-height: 100vh;
    }

    /* ── Nav ── */
    nav {
      position: fixed; top: 0; left: 0; right: 0;
      z-index: 100;
      display: flex; align-items: center; justify-content: space-between;
      padding: 1.2rem 3rem;
      background: rgba(6,10,15,.7);
      backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--border);
      animation: slideDown .8s ease forwards;
    }
    @keyframes slideDown {
      from { transform: translateY(-100%); opacity: 0; }
      to   { transform: translateY(0);    opacity: 1; }
    }

    .nav-logo {
      font-family: var(--font-mono);
      font-size: 1.1rem;
      color: var(--accent3);
      letter-spacing: .05em;
    }
    .nav-logo span { color: var(--accent); }

    .nav-links {
      display: flex; gap: 2.5rem;
      list-style: none;
    }
    .nav-links a {
      font-family: var(--font-mono);
      font-size: .8rem;
      color: var(--muted);
      text-decoration: none;
      letter-spacing: .1em;
      transition: color .3s;
    }
    .nav-links a:hover { color: var(--accent); }

    .nav-status {
      display: flex; align-items: center; gap: .5rem;
      font-family: var(--font-mono); font-size: .75rem; color: var(--accent3);
    }
    .status-dot {
      width: 8px; height: 8px;
      background: var(--accent3); border-radius: 50%;
      animation: pulse 2s ease infinite;
    }
    @keyframes pulse {
      0%,100% { box-shadow: 0 0 0 0 rgba(0,255,136,.4); }
      50%      { box-shadow: 0 0 0 8px rgba(0,255,136,0); }
    }

    /* ── Hero ── */
    .hero {
      min-height: 100vh;
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: center;
      gap: 4rem;
      padding: 7rem 5rem 4rem;
      position: relative;
    }

    .hero-left { animation: fadeInLeft 1s ease .3s both; }
    @keyframes fadeInLeft {
      from { transform: translateX(-60px); opacity: 0; }
      to   { transform: translateX(0);     opacity: 1; }
    }

    .hero-tag {
      display: inline-flex; align-items: center; gap: .5rem;
      font-family: var(--font-mono); font-size: .75rem;
      color: var(--accent); background: rgba(0,212,255,.08);
      border: 1px solid rgba(0,212,255,.25);
      padding: .35rem .9rem; border-radius: 2rem;
      margin-bottom: 1.5rem;
      animation: fadeInLeft 1s ease .2s both;
    }
    .hero-tag::before { content: '//'; color: var(--accent2); margin-right: .3rem; }

    .hero-name {
      font-family: var(--font-sans);
      font-size: clamp(2.8rem, 6vw, 5rem);
      font-weight: 700;
      line-height: 1.05;
      letter-spacing: -.02em;
      margin-bottom: .6rem;
    }
    .hero-name .first { color: var(--text); }
    .hero-name .last  {
      background: linear-gradient(135deg, var(--accent), var(--accent2));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .hero-role {
      font-family: var(--font-mono);
      font-size: 1.1rem;
      color: var(--accent3);
      margin-bottom: 1.6rem;
      min-height: 1.6em;
    }
    .cursor-blink {
      display: inline-block;
      width: 2px; height: 1.1em;
      background: var(--accent3);
      margin-left: 2px;
      vertical-align: middle;
      animation: blink .8s step-end infinite;
    }
    @keyframes blink { 50% { opacity: 0; } }

    .hero-bio {
      font-size: .95rem;
      color: var(--muted);
      line-height: 1.75;
      max-width: 480px;
      margin-bottom: 2.5rem;
    }

    .hero-actions {
      display: flex; gap: 1rem; flex-wrap: wrap;
    }

    .apu {
      height: 300px;
      width: 300px;
      border-radius: 50%;
      object-fit: cover;
    }

    .btn {
      display: inline-flex; align-items: center; gap: .6rem;
      font-family: var(--font-mono); font-size: .85rem;
      padding: .85rem 1.8rem;
      border-radius: 6px;
      cursor: pointer;
      text-decoration: none;
      transition: all .3s ease;
      position: relative; overflow: hidden;
    }
    .btn::after {
      content: '';
      position: absolute; inset: 0;
      background: rgba(255,255,255,.07);
      transform: translateX(-100%);
      transition: transform .4s ease;
    }
    .btn:hover::after { transform: translateX(0); }

    .btn-primary {
      background: linear-gradient(135deg, var(--accent), var(--accent2));
      color: #fff; border: none;
      box-shadow: 0 4px 24px rgba(0,212,255,.25);
    }
    .btn-primary:hover {
      box-shadow: 0 8px 40px rgba(0,212,255,.45);
      transform: translateY(-2px);
    }

    .btn-ghost {
      background: transparent;
      color: var(--text);
      border: 1px solid var(--border);
    }
    .btn-ghost:hover {
      border-color: var(--accent);
      color: var(--accent);
      transform: translateY(-2px);
    }

    /* ── Student info cards ── */
    .student-cards {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: .85rem;
      width: 100%;
      max-width: 380px;
      margin-top: 1rem;
    }

    .info-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: .9rem 1rem;
      display: flex; align-items: center; gap: .75rem;
      transition: all .35s ease;
      position: relative; overflow: hidden;
      cursor: default;
    }
    .info-card::before {
      content: '';
      position: absolute; top: 0; left: 0;
      width: 3px; height: 100%;
      background: var(--accent3);
      transform: scaleY(0);
      transition: transform .3s ease;
      transform-origin: bottom;
    }
    .info-card:hover::before { transform: scaleY(1); }
    .info-card:hover {
      border-color: var(--accent3);
      transform: translateY(-3px);
      box-shadow: 0 8px 24px rgba(0,255,136,.1);
    }

    .info-icon {
      width: 36px; height: 36px; border-radius: 8px;
      display: flex; align-items: center; justify-content: center;
      font-size: 1.2rem; flex-shrink: 0;
    }
    .info-icon.college { background: rgba(0,212,255,.15); }
    .info-icon.year    { background: rgba(0,255,136,.12); }
    .info-icon.branch  { background: rgba(124,58,237,.15); }
    .info-icon.goal    { background: rgba(255,200,0,.12); }

    .info-name   { font-size: .78rem; font-weight: 600; color: var(--text); line-height: 1.2; }
    .info-sub    { font-size: .68rem; color: var(--muted); font-family: var(--font-mono); }

    /* ── Hero stats — now learning-focused ── */
    .hero-stats {
      display: flex; gap: 2rem; margin-top: 2.5rem;
      padding-top: 2rem;
      border-top: 1px solid var(--border);
      flex-wrap: wrap;
      animation: fadeInLeft 1s ease .7s both;
    }
    .stat-num {
      font-size: 1.4rem; font-weight: 700;
      color: var(--accent); font-family: var(--font-mono);
    }
    .stat-label {
      font-size: .7rem; color: var(--muted);
      letter-spacing: .05em; text-transform: uppercase;
      margin-top: .15rem;
    }

    /* ── Right column ── */
    .hero-right {
      display: flex; flex-direction: column;
      align-items: center; gap: 2rem;
      animation: fadeInRight 1s ease .4s both;
    }
    @keyframes fadeInRight {
      from { transform: translateX(60px); opacity: 0; }
      to   { transform: translateX(0);    opacity: 1; }
    }

    .photo-wrapper {
      position: relative;
      width: 300px; height: 300px;
    }
    .photo-ring {
      position: absolute; inset: -8px;
      border-radius: 50%;
      background: conic-gradient(var(--accent), var(--accent2), var(--accent3), var(--accent));
      animation: spin 6s linear infinite;
    }
    @keyframes spin { to { transform: rotate(360deg); } }
    .photo-ring-inner {
      position: absolute; inset: -5px;
      background: var(--bg);
      border-radius: 50%;
    }
    .photo-glow {
      position: absolute; inset: 0;
      border-radius: 50%;
      box-shadow: 0 0 60px 10px rgba(0,212,255,.18),
                  0 0 120px 20px rgba(124,58,237,.1);
      z-index: 1;
      pointer-events: none;
    }
    .photo-placeholder {
      position: absolute; inset: 8px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--surface), var(--bg2));
      z-index: 2;
      display: flex; flex-direction: column;
      align-items: center; justify-content: center;
      gap: .5rem;
      border: 2px solid var(--border);
      overflow: hidden;
    }

    /* ── Learning goals section ── */
    .goals-section {
      padding: 3rem 5rem;
      position: relative; z-index: 1;
      border-top: 1px solid var(--border);
    }
    .goals-header {
      font-family: var(--font-mono); font-size: .7rem;
      color: var(--muted); letter-spacing: .2em;
      text-transform: uppercase; margin-bottom: 1.5rem;
    }
    .goals-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 1.2rem;
    }
    .goal-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 1.4rem;
      transition: all .35s ease;
      position: relative; overflow: hidden;
    }
    .goal-card::after {
      content: '';
      position: absolute; bottom: 0; left: 0; right: 0;
      height: 2px;
      background: linear-gradient(90deg, var(--accent), var(--accent2));
      transform: scaleX(0);
      transition: transform .4s ease;
    }
    .goal-card:hover::after { transform: scaleX(1); }
    .goal-card:hover {
      border-color: rgba(0,212,255,.3);
      transform: translateY(-4px);
      box-shadow: 0 12px 30px rgba(0,0,0,.3);
    }
    .goal-emoji { font-size: 1.8rem; margin-bottom: .8rem; }
    .goal-title { font-weight: 600; font-size: .95rem; color: var(--text); margin-bottom: .4rem; }
    .goal-desc  { font-size: .8rem; color: var(--muted); line-height: 1.6; }

    /* ── Currently learning progress ── */
    .learning-section {
      padding: 0 5rem 3rem;
      position: relative; z-index: 1;
    }
    .learning-header {
      font-family: var(--font-mono); font-size: .7rem;
      color: var(--muted); letter-spacing: .2em;
      text-transform: uppercase; margin-bottom: 1.5rem;
    }
    .learning-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 1rem;
    }
    .learn-item {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 1rem 1.2rem;
    }
    .learn-top {
      display: flex; align-items: center; justify-content: space-between;
      margin-bottom: .6rem;
    }
    .learn-name { font-size: .82rem; font-weight: 600; color: var(--text); }
    .learn-pct  { font-family: var(--font-mono); font-size: .7rem; color: var(--accent); }
    .learn-bar  {
      height: 4px; background: var(--bg2);
      border-radius: 2px; overflow: hidden;
    }
    .learn-fill {
      height: 100%;
      border-radius: 2px;
      background: linear-gradient(90deg, var(--accent), var(--accent2));
      transform-origin: left;
      animation: growBar 1.2s ease .5s both;
    }
    @keyframes growBar { from { transform: scaleX(0); } }
    .learn-sub {
      font-size: .68rem; color: var(--muted);
      font-family: var(--font-mono); margin-top: .4rem;
    }

    /* ── Tech Stack ── */
    .stack-section {
      padding: 2rem 5rem;
      position: relative; z-index: 1;
      border-top: 1px solid var(--border);
    }
    .stack-label {
      font-family: var(--font-mono); font-size: .7rem;
      color: var(--muted); letter-spacing: .2em;
      text-transform: uppercase; margin-bottom: 1rem;
    }
    .stack-pills {
      display: flex; flex-wrap: wrap; gap: .6rem;
    }
    .pill {
      font-family: var(--font-mono); font-size: .72rem;
      color: var(--muted);
      background: var(--surface);
      border: 1px solid var(--border);
      padding: .3rem .85rem; border-radius: 20px;
      transition: all .3s;
    }
    .pill:hover {
      color: var(--accent); border-color: var(--accent);
      background: rgba(0,212,255,.07);
      transform: scale(1.05);
    }
    .pill.beginner { border-color: rgba(0,255,136,.3); color: var(--accent3); }
    .pill.beginner:hover { background: rgba(0,255,136,.08); }

    /* ── Resume Modal ── */
    .modal-overlay {
      position: fixed; inset: 0;
      background: rgba(6,10,15,.85);
      backdrop-filter: blur(12px);
      z-index: 500;
      display: flex; align-items: center; justify-content: center;
      opacity: 0; pointer-events: none;
      transition: opacity .4s ease;
    }
    .modal-overlay.open { opacity: 1; pointer-events: all; }
    .modal {
      width: min(700px, 92vw);
      max-height: 88vh;
      background: var(--bg2);
      border: 1px solid var(--border);
      border-radius: 16px;
      overflow: hidden;
      display: flex; flex-direction: column;
      transform: scale(.9) translateY(30px);
      transition: transform .4s cubic-bezier(.34,1.56,.64,1);
      box-shadow: 0 30px 100px rgba(0,0,0,.6);
    }
    .modal-overlay.open .modal { transform: scale(1) translateY(0); }
    .modal-header {
      padding: 1.2rem 1.6rem;
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      display: flex; align-items: center; justify-content: space-between;
    }
    .modal-title { font-family: var(--font-mono); font-size: .85rem; color: var(--accent3); }
    .modal-close {
      background: none; border: none;
      color: var(--muted); font-size: 1.2rem;
      cursor: pointer; padding: .2rem .5rem;
      transition: color .3s; line-height: 1;
    }
    .modal-close:hover { color: var(--text); }
    .modal-body {
      overflow-y: auto; padding: 2rem; flex: 1;
    }
    .modal-body::-webkit-scrollbar { width: 4px; }
    .modal-body::-webkit-scrollbar-track { background: var(--bg); }
    .modal-body::-webkit-scrollbar-thumb { background: var(--border); border-radius: 2px; }

    /* Resume styles */
    .resume { font-size: .88rem; line-height: 1.6; }
    .resume-header-block {
      text-align: center; margin-bottom: 1.5rem;
      padding-bottom: 1.5rem; border-bottom: 1px solid var(--border);
    }
    .resume-name { font-size: 1.8rem; font-weight: 700; color: var(--text); }
    .resume-sub  { font-family: var(--font-mono); font-size: .8rem; color: var(--accent); margin: .3rem 0 .6rem; }
    .resume-contact {
      display: flex; justify-content: center; gap: 1.5rem; flex-wrap: wrap;
      font-family: var(--font-mono); font-size: .72rem; color: var(--muted);
    }
    .resume-section { margin-bottom: 1.6rem; }
    .resume-section-title {
      font-family: var(--font-mono); font-size: .72rem;
      color: var(--accent); letter-spacing: .2em;
      text-transform: uppercase;
      padding-bottom: .4rem;
      border-bottom: 1px solid var(--border);
      margin-bottom: .9rem;
    }
    .resume-item { margin-bottom: 1rem; }
    .ri-top {
      display: flex; justify-content: space-between;
      align-items: baseline; gap: .5rem; flex-wrap: wrap;
    }
    .ri-title { font-weight: 600; color: var(--text); font-size: .88rem; }
    .ri-date  { font-family: var(--font-mono); font-size: .7rem; color: var(--muted); }
    .ri-sub   { color: var(--accent3); font-size: .78rem; margin: .1rem 0 .3rem; }
    .ri-desc  { color: var(--muted); font-size: .8rem; }
    .ri-desc li { margin-left: 1rem; margin-bottom: .2rem; }

    /* Notice banner inside resume */
    .wip-banner {
      background: rgba(0,255,136,.07);
      border: 1px solid rgba(0,255,136,.2);
      border-radius: 8px;
      padding: .9rem 1.1rem;
      margin-bottom: 1.4rem;
      font-family: var(--font-mono);
      font-size: .75rem;
      color: var(--accent3);
      display: flex; align-items: center; gap: .6rem;
    }

    .skills-grid {
      display: grid; grid-template-columns: repeat(2,1fr); gap: .6rem;
    }
    .skill-row { display: flex; flex-direction: column; gap: .2rem; }
    .skill-label { font-size: .75rem; color: var(--text); }
    .skill-bar { height: 4px; background: var(--surface); border-radius: 2px; overflow: hidden; }
    .skill-fill {
      height: 100%;
      background: linear-gradient(90deg, var(--accent), var(--accent2));
      border-radius: 2px;
      transform-origin: left;
      animation: growBar 1s ease .3s both;
    }

    /* ── Particles ── */
    .particle {
      position: fixed; border-radius: 50%;
      pointer-events: none; z-index: 0;
      animation: floatUp linear infinite;
      opacity: 0;
    }
    @keyframes floatUp {
      0%   { transform: translateY(100vh) scale(0); opacity: 0; }
      10%  { opacity: .6; }
      90%  { opacity: .2; }
      100% { transform: translateY(-100px) scale(1); opacity: 0; }
    }

    /* ── Responsive ── */
    @media (max-width: 900px) {
      .hero {
        grid-template-columns: 1fr;
        text-align: center;
        padding: 6rem 2rem 3rem;
        gap: 3rem;
      }
      .hero-bio { margin: 0 auto 2rem; }
      .hero-actions { justify-content: center; }
      .hero-stats { justify-content: center; }
      .hero-right { order: -1; }
      .stack-section,
      .goals-section,
      .learning-section { padding: 2rem; }
      nav { padding: 1rem 1.5rem; }
      .nav-links { display: none; }
      .student-cards { margin: 0 auto; }
    }
  </style>
</head>
<body>

<div class="cursor" id="cursor"></div>
<div class="cursor-ring" id="cursorRing"></div>
<canvas id="bg-canvas"></canvas>

<!-- Resume Modal -->
