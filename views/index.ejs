            </ul>
          </div>

          <div class="resume-item">
            <div class="ri-top">
              <span class="ri-title">Software Engineer</span>
              <span class="ri-date">Jun 2019 – Dec 2021</span>
            </div>
            <div class="ri-sub">Vercel · Remote</div>
            <ul class="ri-desc">
              <li>Built and maintained core React component library used by 10K+ developers</li>
              <li>Optimized build pipelines cutting deploy times by 50% using edge caching</li>
              <li>Shipped 12 open-source packages with combined 80K+ npm weekly downloads</li>
            </ul>
          </div>
        </div>

        <div class="resume-section">
          <div class="resume-section-title">Education</div>
          <div class="resume-item">
            <div class="ri-top">
              <span class="ri-title">B.Tech — Computer Science & Engineering</span>
              <span class="ri-date">2015 – 2019</span>
            </div>
            <div class="ri-sub">Indian Institute of Technology, Delhi · GPA: 9.1/10</div>
          </div>
        </div>

        <div class="resume-section">
          <div class="resume-section-title">Certifications</div>
          <div class="resume-item">
            <div class="ri-top"><span class="ri-title">AWS Solutions Architect – Professional</span><span class="ri-date">2023</span></div>
            <div class="ri-top"><span class="ri-title">Google Cloud Professional Data Engineer</span><span class="ri-date">2022</span></div>
            <div class="ri-top"><span class="ri-title">Certified Kubernetes Administrator (CKA)</span><span class="ri-date">2022</span></div>
            <div class="ri-top"><span class="ri-title">Meta React Advanced Developer</span><span class="ri-date">2021</span></div>
          </div>
        </div>

        <div class="resume-section">
          <div class="resume-section-title">Skills</div>
          <div class="skills-grid">
            <div class="skill-row">
              <span class="skill-label">React / Next.js</span>
              <div class="skill-bar"><div class="skill-fill" style="width:95%"></div></div>
            </div>
            <div class="skill-row">
              <span class="skill-label">Node.js / Go</span>
              <div class="skill-bar"><div class="skill-fill" style="width:90%"></div></div>
            </div>
            <div class="skill-row">
              <span class="skill-label">AWS / GCP</span>
              <div class="skill-bar"><div class="skill-fill" style="width:88%"></div></div>
            </div>
