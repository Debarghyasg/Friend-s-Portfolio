<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Arpita Roy</title>
  <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@300;400;500;600;700&family=Space+Grotesk:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
  <style>
    :root {
      --bg: #060a0f;
      --bg2: #0d1520;
      --surface: #111c2d;
      --border: #1e3352;
      --accent: #00d4ff;
      --accent2: #7c3aed;
      --accent3: #00ff88;
      --text: #e2eaf5;
      --muted: #6b8aad;
      --font-mono: 'Fira Code', monospace;
      --font-sans: 'Space Grotesk', sans-serif;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html { scroll-behavior: smooth; }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: var(--font-sans);
      overflow-x: hidden;
      cursor: none;
    }

    /* ── Custom cursor ── */
    .cursor {
      width: 12px; height: 12px;
      background: var(--accent);
      border-radius: 50%;
      position: fixed; top: 0; left: 0;
      pointer-events: none; z-index: 9999;
      transition: transform .15s ease;
      mix-blend-mode: screen;
    }
    .cursor-ring {
      width: 36px; height: 36px;
      border: 1.5px solid var(--accent);
      border-radius: 50%;
      position: fixed; top: 0; left: 0;
      pointer-events: none; z-index: 9998;
      transition: transform .3s ease, opacity .3s;
      opacity: .6;
    }

    /* ── Canvas bg ── */
    #bg-canvas {
      position: fixed; inset: 0;
      z-index: 0;
      opacity: .45;
    }

    /* ── Layout ── */
    .page {
      position: relative; z-index: 1;
      min-height: 100vh;
    }

    /* ── Nav ── */
    nav {
      position: fixed; top: 0; left: 0; right: 0;
      z-index: 100;
      display: flex; align-items: center; justify-content: space-between;
      padding: 1.2rem 3rem;
      background: rgba(6,10,15,.7);
      backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--border);
      animation: slideDown .8s ease forwards;
    }
    @keyframes slideDown {
      from { transform: translateY(-100%); opacity: 0; }
      to   { transform: translateY(0);    opacity: 1; }
    }

    .nav-logo {
      font-family: var(--font-mono);
      font-size: 1.1rem;
      color: var(--accent3);
      letter-spacing: .05em;
    }
    .nav-logo span { color: var(--accent); }

    .nav-links {
      display: flex; gap: 2.5rem;
      list-style: none;
    }
    .nav-links a {
      font-family: var(--font-mono);
      font-size: .8rem;
      color: var(--muted);
      text-decoration: none;
      letter-spacing: .1em;
      transition: color .3s;
    }
    .nav-links a:hover { color: var(--accent); }

    .nav-status {
      display: flex; align-items: center; gap: .5rem;
      font-family: var(--font-mono); font-size: .75rem; color: var(--accent3);
    }
    .status-dot {
      width: 8px; height: 8px;
      background: var(--accent3); border-radius: 50%;
      animation: pulse 2s ease infinite;
    }
    @keyframes pulse {
      0%,100% { box-shadow: 0 0 0 0 rgba(0,255,136,.4); }
      50%      { box-shadow: 0 0 0 8px rgba(0,255,136,0); }
    }

    /* ── Hero Section ── */
    .hero {
      min-height: 100vh;
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: center;
      gap: 4rem;
      padding: 7rem 5rem 4rem;
      position: relative;
    }

    /* Left column */
    .hero-left { animation: fadeInLeft 1s ease .3s both; }
    @keyframes fadeInLeft {
      from { transform: translateX(-60px); opacity: 0; }
      to   { transform: translateX(0);     opacity: 1; }
    }

    .hero-tag {
      display: inline-flex; align-items: center; gap: .5rem;
      font-family: var(--font-mono); font-size: .75rem;
      color: var(--accent); background: rgba(0,212,255,.08);
      border: 1px solid rgba(0,212,255,.25);
      padding: .35rem .9rem; border-radius: 2rem;
      margin-bottom: 1.5rem;
      animation: fadeInLeft 1s ease .2s both;
    }
    .hero-tag::before { content: '//'; color: var(--accent2); margin-right: .3rem; }

    .hero-name {
      font-family: var(--font-sans);
      font-size: clamp(2.8rem, 6vw, 5rem);
      font-weight: 700;
      line-height: 1.05;
      letter-spacing: -.02em;
      margin-bottom: .6rem;
    }
    .hero-name .first { color: var(--text); }
    .hero-name .last  {
      background: linear-gradient(135deg, var(--accent), var(--accent2));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .hero-role {
      font-family: var(--font-mono);
      font-size: 1.1rem;
      color: var(--accent3);
      margin-bottom: 1.6rem;
      min-height: 1.6em;
    }
    .cursor-blink {
      display: inline-block;
      width: 2px; height: 1.1em;
      background: var(--accent3);
      margin-left: 2px;
      vertical-align: middle;
      animation: blink .8s step-end infinite;
    }
    @keyframes blink { 50% { opacity: 0; } }

    .hero-bio {
      font-size: .95rem;
      color: var(--muted);
      line-height: 1.75;
      max-width: 480px;
      margin-bottom: 2.5rem;
    }

    .hero-actions {
      display: flex; gap: 1rem; flex-wrap: wrap;
    }
    .apu{
        height:300px;
        width:300px;
        border-radius:15%;
    }

    .btn {
      display: inline-flex; align-items: center; gap: .6rem;
      font-family: var(--font-mono); font-size: .85rem;
      padding: .85rem 1.8rem;
      border-radius: 6px;
      cursor: pointer;
      text-decoration: none;
      transition: all .3s ease;
      position: relative; overflow: hidden;
    }
    .btn::after {
      content: '';
      position: absolute; inset: 0;
      background: rgba(255,255,255,.07);
      transform: translateX(-100%);
      transition: transform .4s ease;
    }
    .btn:hover::after { transform: translateX(0); }

    .btn-primary {
      background: linear-gradient(135deg, var(--accent), var(--accent2));
      color: #fff; border: none;
      box-shadow: 0 4px 24px rgba(0,212,255,.25);
    }
    .btn-primary:hover {
      box-shadow: 0 8px 40px rgba(0,212,255,.45);
      transform: translateY(-2px);
    }

    .btn-ghost {
      background: transparent;
      color: var(--text);
      border: 1px solid var(--border);
    }
    .btn-ghost:hover {
      border-color: var(--accent);
      color: var(--accent);
      transform: translateY(-2px);
    }

    .hero-stats {
      display: flex; gap: 2.5rem; margin-top: 2.5rem;
      padding-top: 2rem;
      border-top: 1px solid var(--border);
      animation: fadeInLeft 1s ease .7s both;
    }
    .stat-num {
      font-size: 1.6rem; font-weight: 700;
      color: var(--accent); font-family: var(--font-mono);
    }
    .stat-label {
      font-size: .75rem; color: var(--muted);
      letter-spacing: .05em; text-transform: uppercase;
    }

    /* Right column — photo */
    .hero-right {
      display: flex; flex-direction: column;
      align-items: center; gap: 2rem;
      animation: fadeInRight 1s ease .4s both;
    }
    @keyframes fadeInRight {
      from { transform: translateX(60px); opacity: 0; }
      to   { transform: translateX(0);    opacity: 1; }
    }

    .photo-wrapper {
      position: relative;
      width: 300px; height: 300px;
    }
    .photo-ring {
      /* position: absolute; inset: -8px; */
      border-radius: 50%;
      background: conic-gradient(var(--accent), var(--accent2), var(--accent3), var(--accent));
      animation: spin 6s linear infinite;
    }
    @keyframes spin { to { transform: rotate(360deg); } }

    .photo-ring-inner {
      position: absolute; inset: 3px;
      background: var(--bg);
      border-radius: 50%;
    }
    .photo-img {
      position: absolute; inset: 8px;
      border-radius: 50%;
      object-fit: cover;
      width: calc(100% - 16px);
      height: calc(100% - 16px);
      z-index: 2;
      background: var(--surface);
      display: flex; align-items: center; justify-content: center;
      overflow: hidden;
    }
    /* Placeholder avatar */
    .photo-placeholder {
      position: absolute; inset: 8px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--surface), var(--bg2));
      z-index: 2;
      display: flex; flex-direction: column;
      align-items: center; justify-content: center;
      gap: .5rem;
      border: 2px solid var(--border);
    }
    .photo-placeholder svg {
      width: 90px; height: 90px;
      opacity: .4;
    }
    .photo-placeholder span {
      font-family: var(--font-mono); font-size: .65rem;
      color: var(--muted);
    }

    .photo-glow {
      position: absolute; inset: 0;
      border-radius: 50%;
      box-shadow: 0 0 60px 10px rgba(0,212,255,.18),
                  0 0 120px 20px rgba(124,58,237,.1);
      z-index: 1;
      pointer-events: none;
    }

    /* Certifications */
    .certs-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: .85rem;
      width: 100%;
      max-width: 380px;
    }

    .cert-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: .9rem 1rem;
      display: flex; align-items: center; gap: .75rem;
      transition: all .35s ease;
      position: relative; overflow: hidden;
      cursor: default;
    }
    .cert-card::before {
      content: '';
      position: absolute; top: 0; left: 0;
      width: 3px; height: 100%;
      background: var(--accent);
      transform: scaleY(0);
      transition: transform .3s ease;
      transform-origin: bottom;
    }
    .cert-card:hover::before { transform: scaleY(1); }
    .cert-card:hover {
      border-color: var(--accent);
      transform: translateY(-3px);
      box-shadow: 0 8px 24px rgba(0,212,255,.12);
    }

    .cert-icon {
      width: 36px; height: 36px; border-radius: 8px;
      display: flex; align-items: center; justify-content: center;
      font-size: 1.2rem; flex-shrink: 0;
    }
    .cert-icon.aws   { background: rgba(255,153,0,.15); }
    .cert-icon.gcp   { background: rgba(66,133,244,.15); }
    .cert-icon.react { background: rgba(97,218,251,.15); }
    .cert-icon.k8s   { background: rgba(50,108,229,.15); }

    .cert-info {}
    .cert-name { font-size: .78rem; font-weight: 600; color: var(--text); line-height: 1.2; }
    .cert-issuer { font-size: .68rem; color: var(--muted); font-family: var(--font-mono); }

    /* ── Tech Stack bar ── */
    .stack-section {
      padding: 2rem 5rem;
      position: relative; z-index: 1;
      border-top: 1px solid var(--border);
      animation: fadeUp 1s ease .9s both;
    }
    @keyframes fadeUp {
      from { transform: translateY(30px); opacity: 0; }
      to   { transform: translateY(0);    opacity: 1; }
    }

    .stack-label {
      font-family: var(--font-mono); font-size: .7rem;
      color: var(--muted); letter-spacing: .2em;
      text-transform: uppercase; margin-bottom: 1rem;
    }
    .stack-pills {
      display: flex; flex-wrap: wrap; gap: .6rem;
    }
    .pill {
      font-family: var(--font-mono); font-size: .72rem;
      color: var(--muted);
      background: var(--surface);
      border: 1px solid var(--border);
      padding: .3rem .85rem; border-radius: 20px;
      transition: all .3s;
    }
    .pill:hover {
      color: var(--accent); border-color: var(--accent);
      background: rgba(0,212,255,.07);
      transform: scale(1.05);
    }

    /* ── Code window decoration ── */
    .code-window {
      position: absolute;
      right: 5rem; bottom: 6rem;
      width: 280px;
      background: rgba(13,21,32,.9);
      border: 1px solid var(--border);
      border-radius: 10px;
      overflow: hidden;
      font-family: var(--font-mono);
      font-size: .7rem;
      box-shadow: 0 20px 60px rgba(0,0,0,.5);
      animation: fadeInRight 1.2s ease .8s both;
      display: none; /* shown on wider screens */
    }
    .cw-header {
      background: var(--surface);
      padding: .5rem .8rem;
      display: flex; align-items: center; gap: .4rem;
    }
    .cw-dot { width: 10px; height: 10px; border-radius: 50%; }
    .cw-dot.r { background: #ff5f57; }
    .cw-dot.y { background: #febc2e; }
    .cw-dot.g { background: #28c840; }
    .cw-body { padding: .8rem 1rem; line-height: 1.9; }
    .c-kw  { color: #c792ea; }
    .c-fn  { color: #82aaff; }
    .c-str { color: #c3e88d; }
    .c-num { color: #f78c6c; }
    .c-cm  { color: #546e7a; }
    .c-acc { color: var(--accent); }

    /* ── Resume Modal ── */
    .modal-overlay {
      position: fixed; inset: 0;
      background: rgba(6,10,15,.85);
      backdrop-filter: blur(12px);
      z-index: 500;
      display: flex; align-items: center; justify-content: center;
      opacity: 0; pointer-events: none;
      transition: opacity .4s ease;
    }
    .modal-overlay.open {
      opacity: 1; pointer-events: all;
    }

    .modal {
      width: min(700px, 92vw);
      max-height: 88vh;
      background: var(--bg2);
      border: 1px solid var(--border);
      border-radius: 16px;
      overflow: hidden;
      display: flex; flex-direction: column;
      transform: scale(.9) translateY(30px);
      transition: transform .4s cubic-bezier(.34,1.56,.64,1);
      box-shadow: 0 30px 100px rgba(0,0,0,.6);
    }
    .modal-overlay.open .modal {
      transform: scale(1) translateY(0);
    }

    .modal-header {
      padding: 1.2rem 1.6rem;
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      display: flex; align-items: center; justify-content: space-between;
    }
    .modal-title {
      font-family: var(--font-mono); font-size: .85rem;
      color: var(--accent3);
    }
    .modal-close {
      background: none; border: none;
      color: var(--muted); font-size: 1.2rem;
      cursor: pointer; padding: .2rem .5rem;
      transition: color .3s;
      line-height: 1;
    }
    .modal-close:hover { color: var(--text); }

    .modal-body {
      overflow-y: auto; padding: 2rem;
      flex: 1;
    }
    .modal-body::-webkit-scrollbar { width: 4px; }
    .modal-body::-webkit-scrollbar-track { background: var(--bg); }
    .modal-body::-webkit-scrollbar-thumb { background: var(--border); border-radius: 2px; }

    /* Resume styles inside modal */
    .resume { font-size: .88rem; line-height: 1.6; }
    .resume-header-block {
      text-align: center; margin-bottom: 1.5rem;
      padding-bottom: 1.5rem; border-bottom: 1px solid var(--border);
    }
    .resume-name { font-size: 1.8rem; font-weight: 700; color: var(--text); }
    .resume-sub  {
      font-family: var(--font-mono); font-size: .8rem;
      color: var(--accent); margin: .3rem 0 .6rem;
    }
    .resume-contact {
      display: flex; justify-content: center; gap: 1.5rem; flex-wrap: wrap;
      font-family: var(--font-mono); font-size: .72rem; color: var(--muted);
    }

    .resume-section { margin-bottom: 1.6rem; }
    .resume-section-title {
      font-family: var(--font-mono); font-size: .72rem;
      color: var(--accent); letter-spacing: .2em;
      text-transform: uppercase;
      padding-bottom: .4rem;
      border-bottom: 1px solid var(--border);
      margin-bottom: .9rem;
    }

    .resume-item { margin-bottom: 1rem; }
    .ri-top {
      display: flex; justify-content: space-between;
      align-items: baseline; gap: .5rem; flex-wrap: wrap;
    }
    .ri-title { font-weight: 600; color: var(--text); font-size: .88rem; }
    .ri-date  { font-family: var(--font-mono); font-size: .7rem; color: var(--muted); }
    .ri-sub   { color: var(--accent3); font-size: .78rem; margin: .1rem 0 .3rem; }
    .ri-desc  { color: var(--muted); font-size: .8rem; }
    .ri-desc li { margin-left: 1rem; margin-bottom: .2rem; }

    .skills-grid {
      display: grid; grid-template-columns: repeat(2,1fr); gap: .6rem;
    }
    .skill-row { display: flex; flex-direction: column; gap: .2rem; }
    .skill-label { font-size: .75rem; color: var(--text); }
    .skill-bar {
      height: 4px; background: var(--surface);
      border-radius: 2px; overflow: hidden;
    }
    .skill-fill {
      height: 100%;
      background: linear-gradient(90deg, var(--accent), var(--accent2));
      border-radius: 2px;
      transform-origin: left;
      animation: growBar 1s ease .3s both;
    }
    @keyframes growBar { from { transform: scaleX(0); } }

    /* ── Floating particles ── */
    .particle {
      position: fixed; border-radius: 50%;
      pointer-events: none; z-index: 0;
      animation: floatUp linear infinite;
      opacity: 0;
    }
    @keyframes floatUp {
      0%   { transform: translateY(100vh) scale(0); opacity: 0; }
      10%  { opacity: .6; }
      90%  { opacity: .2; }
      100% { transform: translateY(-100px) scale(1); opacity: 0; }
    }

    /* ── Responsive ── */
    @media (max-width: 900px) {
      .hero {
        grid-template-columns: 1fr;
        text-align: center;
        padding: 6rem 2rem 3rem;
        gap: 3rem;
      }
      .hero-bio { margin: 0 auto 2rem; }
      .hero-actions { justify-content: center; }
      .hero-stats { justify-content: center; }
      .hero-right { order: -1; }
      .stack-section { padding: 2rem; }
      nav { padding: 1rem 1.5rem; }
      .nav-links { display: none; }
    }
  </style>
</head>
<body>

<!-- Custom cursor -->
<div class="cursor" id="cursor"></div>
<div class="cursor-ring" id="cursorRing"></div>

<!-- Background canvas -->
<canvas id="bg-canvas"></canvas>

<!-- Resume Modal -->
<div class="modal-overlay" id="resumeModal">
  <div class="modal">
    <div class="modal-header">
      <span class="modal-title">// resume.pdf — Arpita Roy</span>
      <button class="modal-close" id="closeModal">✕</button>
    </div>
    <div class="modal-body">
      <div class="resume">
        <div class="resume-header-block">
          <div class="resume-name">Arpita Roy</div>
          <div class="resume-sub">Full-Stack Software Engineer</div>
          <div class="resume-contact">
            <span>📧 your email</span>
            <span>📱 +1 (555) 012-3456</span>
            <span>🌐 alexmorgan.dev</span>
            <span>🔗 github.com/alexmorgan</span>
          </div>
        </div>

        <div class="resume-section">
          <div class="resume-section-title">Summary</div>
          <p style="color:var(--muted);font-size:.82rem;line-height:1.7">
            Software Engineer with 5+ years of experience building scalable, high-performance web applications.
            Proficient in React, Node.js, Go, and cloud-native architectures. Passionate about clean code,
            open-source, and developer experience.
          </p>
        </div>

        <div class="resume-section">
          <div class="resume-section-title">Experience</div>

          <div class="resume-item">
            <div class="ri-top">
              <span class="ri-title">Senior Software Engineer</span>
              <span class="ri-date">Jan 2022 – Present</span>
            </div>
            <div class="ri-sub">Stripe Inc. · San Francisco, CA (Remote)</div>
            <ul class="ri-desc">
